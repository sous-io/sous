node_modules
node_modules/
dist/
coverage/
# The packages `pnpm e2e --local` packs from this checkout.
/e2e/.local/
deprecated/
settings.local.js
/docs/notes

# Build state written by sous itself
proj.sous.state.json
sous.state.json
sous.pid

# Machine-specific env for the discovered .sous/ config. Note that the shared
# defaults layer, .sous/.env, is deliberately NOT ignored: it is committed.
.sous/.env.local

# Per-branch task files (taskFileRoot). Local working notes, never committed.
/.sous/tasks/

# Compiled agent instructions. These are OUTPUTS written by `sous build`; the
# tracked sources live in .sous/memories/ and .sous/prompts/. Root-anchored on
# purpose: the sources under .sous/ and recipes/ are NOT affected by these rules.
# /.claude/ holds the memories file (.claude/rules/SOUS-MEMORIES.md) and the
# skills; /AGENTS.override.md and /.agents/ are the memories file and the skills
# sous writes for Codex, should the project turn Codex on. The root CLAUDE.md
# is no longer compiled; it stays ignored so a copy an older build left behind
# is never committed.
/CLAUDE.md
/AGENTS.md
/AGENTS.override.md
/.agents/
/.claude/
/.codex/
/docs/CLAUDE.md
.idea/

# Copied into the published package only while it is packed (packages/sous/scripts/pack-files.mjs).
/packages/sous/recipes/
/packages/sous/docs/
/packages/sous/sous.config.schema.json
