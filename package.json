{
  "name": "@sous-io/sous",
  "version": "0.1.1",
  "description": "Compiles AI coding agent configuration (CLAUDE.md, skills, memories) from LiquidJS templates",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Luke Chavers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sous-io/sous.git"
  },
  "homepage": "https://sous-io.github.io/sous",
  "bugs": "https://github.com/sous-io/sous/issues",
  "keywords": [
    "cli",
    "ai",
    "agents",
    "claude",
    "claude-code",
    "codex",
    "prompts",
    "skills",
    "templates",
    "liquidjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sous": "./bin/run.js"
  },
  "files": [
    "bin/run.js",
    "src",
    "!src/**/*.spec.ts",
    "!src/test",
    "recipes",
    "docs/markdown/*.md",
    "sous.config.schema.json"
  ],
  "scripts": {
    "build": "tsc",
    "sous:build": "./bin/sous build --rebuild",
    "claude": "./bin/sous launch claude",
    "clean": "rm -rf dist",
    "schema:build": "tsx scripts/build-schema.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@inquirer/core": "^11.1.7",
    "@inquirer/prompts": "^8.3.2",
    "@oclif/color": "^1.0.13",
    "@oclif/core": "^4",
    "chokidar": "^5.0.0",
    "glob": "^13.0.6",
    "jsonc-parser": "^3.3.1",
    "liquidjs": "^10.25.0",
    "minimatch": "^10.2.4",
    "semver": "^7.8.5",
    "tiktoken": "^1.0.22",
    "tsx": "^4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "^22",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.0",
    "memfs": "^4.56.11",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "oclif": {
    "bin": "sous",
    "dirname": "sous",
    "flexibleTaxonomy": true,
    "topicSeparator": " ",
    "additionalHelpFlags": [
      "-h"
    ],
    "commands": {
      "strategy": "pattern",
      "target": "./src/commands"
    },
    "topics": {
      "config": {
        "description": "Inspect the merged configuration"
      },
      "configs": {
        "description": "Inspect the merged configuration",
        "hidden": true
      },
      "repo": {
        "description": "Manage the recipe repositories this project trusts"
      },
      "repos": {
        "description": "Manage the recipe repositories this project trusts",
        "hidden": true
      },
      "subscription": {
        "description": "Manage which recipes this project subscribes to"
      },
      "subscriptions": {
        "description": "Manage which recipes this project subscribes to",
        "hidden": true
      },
      "vars": {
        "description": "Recipe variables and their answers"
      },
      "var": {
        "description": "Recipe variables and their answers",
        "hidden": true
      }
    }
  },
  "engines": {
    "node": ">=22"
  }
}
