{
  "name": "sous-workspace",
  "description": "The sous monorepo: the published @sous-io/sous lives in packages/sous",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Luke Chavers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sous-io/sous.git"
  },
  "homepage": "https://sous.io",
  "bugs": "https://github.com/sous-io/sous/issues",
  "scripts": {
    "build": "pnpm --filter @sous-io/plugin-api build && pnpm --filter @sous-io/sous build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sous:build": "./bin/sous build --rebuild",
    "claude": "./bin/sous launch claude",
    "schema:build": "tsx scripts/build-schema.mts",
    "version:sync": "tsx scripts/sync-core-version.mts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.0",
    "esbuild": "^0.27.4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "private": true
}
