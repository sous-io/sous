{
  "name": "@sous-io/plugin-github",
  "version": "1.0.2",
  "description": "A repository-host entity for GitHub: reading indexes, the token, proposing changes, the CI workflow.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@sous-io/plugin-api": "workspace:*",
    "@sous-io/plugin-recipes": "workspace:*",
    "@sous-io/plugin-host": "workspace:*",
    "@sous-io/plugin-git": "workspace:*",
    "@sous-io/repository-hosts": "workspace:*"
  },
  "devDependencies": {
    "@sous-io/core": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
