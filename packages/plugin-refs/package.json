{
  "name": "@sous-io/plugin-refs",
  "version": "1.0.2",
  "description": "Parsing and resolving refs, picking among matches, # names, repository locations and identity.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "exports": {
    ".": {
      "source": "./src/index.ts",
