{
  "name": "@sous-io/sous-plugin-handlers",
  "version": "1.0.19",
  "description": "Handlers: functions a recipe or plugin provides for a purpose (check, configure, beforeBuild, afterBuild, uninstall, migrate), the helpers they receive, and the intents that run them.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@sous-io/plugin-api": "workspace:*",
    "@sous-io/sous-plugin-doctor": "workspace:*",
    "@sous-io/plugin-formats": "workspace:*",
    "@sous-io/plugin-host": "workspace:*",
    "@sous-io/plugin-recipe-answers": "workspace:*",
    "@sous-io/plugin-recipes": "workspace:*",
    "@sous-io/plugin-variables": "workspace:*"
  },
  "devDependencies": {
    "@sous-io/core": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
