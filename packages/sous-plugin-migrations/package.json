{
  "name": "@sous-io/sous-plugin-migrations",
  "version": "1.1.2",
  "description": "Migrations: the steps that bring a project's files in line with a newer version of sous, and the notice that some are waiting.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@sous-io/sous-plugin-api": "workspace:*",
    "@sous-io/sous-plugin-doctor": "workspace:*",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@sous-io/sous-lib-core": "workspace:*",
    "@sous-io/sous-plugin-formats": "workspace:*",
    "@sous-io/sous-plugin-recipes": "workspace:*",
    "@types/semver": "^7.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
