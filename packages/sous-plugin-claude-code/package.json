{
  "name": "@sous-io/sous-plugin-claude-code",
  "version": "1.1.5",
  "description": "Everything sous knows about Claude Code: its harness, skill and memory targets, its content kinds, and its migrations.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@sous-io/sous-plugin-api": "workspace:*",
    "@sous-io/sous-plugin-skills": "workspace:*",
    "@sous-io/sous-plugin-memories": "workspace:*",
    "@sous-io/sous-plugin-harnesses": "workspace:*",
    "@sous-io/sous-plugin-host": "workspace:*",
    "@sous-io/sous-plugin-recipes": "workspace:*",
    "@sous-io/sous-plugin-compiler": "workspace:*",
    "@sous-io/sous-plugin-migrations": "workspace:*",
    "@sous-io/sous-lib-documents": "workspace:*",
    "@sous-io/sous-plugin-config-files": "workspace:*",
    "@sous-io/sous-plugin-confd": "workspace:*",
    "@sous-io/sous-plugin-build": "workspace:*"
  },
  "devDependencies": {
    "@sous-io/sous-lib-core": "workspace:*",
    "@sous-io/sous-plugin-doctor": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
