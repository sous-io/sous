{
  "name": "@sous-io/plugin-confd",
  "version": "1.0.2",
  "description": "The conf.d files, one contributor per file, and surgical edits to the managed conf.d/5xx files.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@sous-io/documents": "workspace:*",
    "@sous-io/plugin-api": "workspace:*",
    "@sous-io/plugin-config-files": "workspace:*",
    "@sous-io/plugin-expressions": "workspace:*",
    "@sous-io/plugin-host": "workspace:*",
    "@sous-io/plugin-variables": "workspace:*"
  },
  "devDependencies": {
    "@sous-io/core": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
