    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@sous-io/plugin-api": "workspace:*",
    "@sous-io/plugin-refs": "workspace:*",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sous-io/core": "workspace:*",
    "@types/semver": "^7.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
