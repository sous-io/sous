{
  "name": "@sous-io/plugin-formats",
  "version": "1.0.1",
  "description": "One parser per on-disk format, reading manifests, and the recipe content hash.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
