{
  "name": "@sous-io/sous-plugin-doctor",
  "version": "1.1.4",
  "description": "sous doctor: runs every check a plugin adds, reports what it found, and offers to fix what it can.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@sous-io/sous-plugin-api": "workspace:*"
  },
  "devDependencies": {
    "@sous-io/sous-lib-core": "workspace:*",
    "@sous-io/sous-plugin-build": "workspace:*",
    "@sous-io/sous-plugin-compiler": "workspace:*",
    "@sous-io/sous-plugin-formats": "workspace:*",
    "@sous-io/sous-plugin-recipe-answers": "workspace:*",
    "@sous-io/sous-plugin-recipes": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
