{
  "name": "@sous-io/sous-plugin-codex",
  "version": "1.0.19",
  "description": "Everything sous knows about Codex: its harness, its memories file (AGENTS.override.md) and its skills folder. Off until a project turns it on.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@sous-io/plugin-api": "workspace:*",
    "@sous-io/sous-plugin-skills": "workspace:*",
    "@sous-io/sous-plugin-memories": "workspace:*",
    "@sous-io/sous-plugin-harnesses": "workspace:*",
    "@sous-io/sous-plugin-host": "workspace:*"
  },
  "devDependencies": {
    "@sous-io/core": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
