{
  "name": "@sous-io/plugin-host",
  "version": "1.0.2",
  "description": "The machine sous runs on: processes, HTTP, globs and paths, sous home, self-describing directories, the .gitignore block, package identity.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@sous-io/plugin-api": "workspace:*",
    "glob": "^13.0.6",
    "minimatch": "^10.2.4"
  },
  "devDependencies": {
    "@sous-io/core": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
