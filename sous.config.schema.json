{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "_env": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "_vars": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "_aliases": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "name": {
      "type": "string"
    },
    "compilation": {
      "type": "object",
      "properties": {
        "_vars": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "includeSourceComments": {
          "type": "boolean"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "_vars": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "entryPoint": {
                "type": "string"
              },
              "entryGlob": {
                "type": "string"
              },
              "globBase": {
                "type": "string"
              },
              "generateRuntimeContext": {
                "type": "boolean"
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "_if": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "eq": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "eq"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "_vars": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "destinationFile": {
                      "type": "string"
                    },
                    "destinationDir": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "outputs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "targets"
      ],
      "additionalProperties": false
    },
    "runtimeContext": {
      "type": "object",
      "properties": {
        "gitRoot": {
          "type": "string"
        },
        "outputPath": {
          "type": "string"
        },
        "taskFileRoot": {
          "type": "string"
        },
        "branchPattern": {
          "type": "string"
        }
      },
      "required": [
        "gitRoot",
        "outputPath",
        "taskFileRoot"
      ],
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "promptFile": {
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://sous-io.github.io/sous/sous.config.schema.json",
  "title": "Sous config"
}
